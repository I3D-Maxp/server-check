#!/bin/sh
set -eu
lb config noauto \
    --mode debian \
    --distribution trixie \
    --architecture amd64 \
    --linux-flavours amd64 \
    --binary-image iso-hybrid \
    --bootloaders 'syslinux grub-efi' \
    --system live \
    --initramfs live-boot \
    --initsystem systemd \
    --debian-installer none \
    --archive-areas 'main' \
    --memtest none \
    --iso-volume SERVER_CHECK \
    --iso-application 'Server Check Diagnostic Live' \
    --bootappend-live 'boot=live components ip=none raid=noautodetect' \
    "$@"
